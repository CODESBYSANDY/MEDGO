{
  "info": {
    "name": "MEDGO Pharmacy Platform API",
    "_postman_id": "a9182374-1234-5678-90ab-cdef12345678",
    "description": "Complete Postman collection for MEDGO - Medicine ordering, prescription management, and delivery backend platform.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "customerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "ownerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "deliveryKey",
      "value": "medgo-delivery-demo-key-2026",
      "type": "string"
    },
    {
      "key": "pharmacyId",
      "value": "c1111111-1111-1111-1111-111111111111",
      "type": "string"
    },
    {
      "key": "medicineId",
      "value": "11111111-0000-0000-0000-000000000001",
      "type": "string"
    },
    {
      "key": "patientId",
      "value": "PAT1001",
      "type": "string"
    },
    {
      "key": "prescriptionId",
      "value": "e1111111-1111-1111-1111-111111111111",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "",
      "type": "string"
    },
    {
      "key": "qrToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Arun Kumar\",\n  \"email\": \"arun.new@gmail.com\",\n  \"phone\": \"9876543210\",\n  \"password\": \"123456\",\n  \"role\": \"CUSTOMER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Register Pharmacy Owner",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ramesh\",\n  \"email\": \"ramesh.new@gmail.com\",\n  \"phone\": \"9876543211\",\n  \"password\": \"123456\",\n  \"role\": \"PHARMACY_OWNER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data.token) {",
                  "    pm.collectionVariables.set('customerToken', res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"arun@gmail.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login Pharmacy Owner",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data.token) {",
                  "    pm.collectionVariables.set('ownerToken', res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ramesh@gmail.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Pharmacies",
      "item": [
        {
          "name": "Get Nearby Pharmacies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pharmacies?lat=9.9252&lng=78.1198&radius_km=5",
              "host": ["{{baseUrl}}"],
              "path": ["pharmacies"],
              "query": [
                { "key": "lat", "value": "9.9252" },
                { "key": "lng", "value": "78.1198" },
                { "key": "radius_km", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "Get Pharmacy Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pharmacies/{{pharmacyId}}",
              "host": ["{{baseUrl}}"],
              "path": ["pharmacies", "{{pharmacyId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Medicines",
      "item": [
        {
          "name": "Search Medicines",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/medicines?search=paracetamol&pharmacy_id={{pharmacyId}}",
              "host": ["{{baseUrl}}"],
              "path": ["medicines"],
              "query": [
                { "key": "search", "value": "paracetamol" },
                { "key": "pharmacy_id", "value": "{{pharmacyId}}" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Prescriptions",
      "item": [
        {
          "name": "Upload Prescription",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "patient_id", "value": "{{patientId}}", "type": "text" },
                { "key": "image", "type": "file", "src": "" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/prescriptions",
              "host": ["{{baseUrl}}"],
              "path": ["prescriptions"]
            }
          }
        },
        {
          "name": "Get Patient Prescriptions",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/patients/{{patientId}}/prescriptions",
              "host": ["{{baseUrl}}"],
              "path": ["patients", "{{patientId}}", "prescriptions"]
            }
          }
        },
        {
          "name": "Get Prescription Details",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/prescriptions/{{prescriptionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["prescriptions", "{{prescriptionId}}"]
            }
          }
        },
        {
          "name": "Update Prescription Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"VERIFIED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/prescriptions/{{prescriptionId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["prescriptions", "{{prescriptionId}}", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data.id) {",
                  "    pm.collectionVariables.set('orderId', res.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pharmacy_id\": \"{{pharmacyId}}\",\n  \"prescription_id\": \"{{prescriptionId}}\",\n  \"items\": [\n    {\n      \"medicine_id\": \"{{medicineId}}\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "Get Order Details",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}"]
            }
          }
        },
        {
          "name": "Update Order Status - Accepted",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PHARMACY_ACCEPTED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}", "status"]
            }
          }
        },
        {
          "name": "Update Order Status - Verified",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PRESCRIPTION_VERIFIED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}", "status"]
            }
          }
        },
        {
          "name": "Update Order Status - Packed",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"MEDICINES_PACKED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}", "status"]
            }
          }
        },
        {
          "name": "Generate Parcel QR Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data.qr_token) {",
                  "    pm.collectionVariables.set('qrToken', res.data.qr_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/qr",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}", "qr"]
            }
          }
        }
      ]
    },
    {
      "name": "Delivery",
      "item": [
        {
          "name": "Verify QR Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-delivery-key", "value": "{{deliveryKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qr_token\": \"{{qrToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/delivery/verify",
              "host": ["{{baseUrl}}"],
              "path": ["delivery", "verify"]
            }
          }
        },
        {
          "name": "Update Delivery Status - Picked Up",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "x-delivery-key", "value": "{{deliveryKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PICKED_UP\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/delivery/{{orderId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["delivery", "{{orderId}}", "status"]
            }
          }
        },
        {
          "name": "Update Delivery Status - Delivered",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "x-delivery-key", "value": "{{deliveryKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"DELIVERED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/delivery/{{orderId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["delivery", "{{orderId}}", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "Owner",
      "item": [
        {
          "name": "Owner Dashboard",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/owner/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["owner", "dashboard"]
            }
          }
        },
        {
          "name": "Owner Orders",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/owner/orders",
              "host": ["{{baseUrl}}"],
              "path": ["owner", "orders"]
            }
          }
        },
        {
          "name": "Update Pharmacy Availability",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_open\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/owner/pharmacy/availability",
              "host": ["{{baseUrl}}"],
              "path": ["owner", "pharmacy", "availability"]
            }
          }
        }
      ]
    }
  ]
}
